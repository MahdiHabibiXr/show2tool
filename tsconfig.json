{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "vitest/globals"
    ]
  },
  "include": [
    "spike/**/*.ts",
    "test/**/*.ts",
    "vitest.config.ts",
    "src/**/*.ts",
    "scripts/**/*.ts"
  ]
}
